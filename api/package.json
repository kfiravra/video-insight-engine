{
  "name": "@vie/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@fastify/cookie": "^9.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/helmet": "^11.1.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.0",
    "@sentry/node": "^10.53.1",
    "@vie/types": "workspace:^",
    "amqplib": "^0.10.9",
    "bcrypt": "^5.1.0",
    "fastify": "^4.26.0",
    "fastify-plugin": "^4.5.0",
    "ioredis": "^5.11.0",
    "mongodb": "^6.3.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.18.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.1",
    "fast-check": "^3.23.2",
    "globals": "^16.5.0",
    "mongodb-memory-server": "^10.4.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.46.4",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "bash ../scripts/precommit-no-debug.sh",
      "eslint --fix"
    ]
  }
}
