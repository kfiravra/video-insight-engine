# ================================================
# Video Insight Engine — server .env template
# ================================================
# On the server: copy to `.env` next to docker-compose.prod.yml, fill in REQUIRED, `chmod 600 .env`.
# Start: docker compose -f docker-compose.prod.yml -f docker-compose.aws.yml up -d
# Secrets: openssl rand -hex 32 (hex, because passwords are embedded in connection URIs).
# Never commit the real file. The dev stack (docker compose up) also reads this template.

# ------------------------------------------------
# REQUIRED — domain and public URLs
# ------------------------------------------------
# Public hostname Caddy serves and requests a TLS certificate for
DOMAIN=your-domain.example
# Browser origin of the web app, exactly (https, no trailing slash)
FRONTEND_URL=https://your-domain.example
# API base baked into the web bundle at build time; /api = same origin through Caddy
VITE_API_URL=/api
# WebSocket origin baked into the web bundle at build time (a trailing /ws is optional)
VITE_WS_URL=wss://your-domain.example

# ------------------------------------------------
# REQUIRED — secrets (replace every value; placeholders are refused or unsafe in production)
# ------------------------------------------------
# Mongo root user, created on the first boot of an empty data volume
MONGO_ROOT_USER=vieadmin
# Mongo root password (changing it later needs db.changeUserPassword first)
MONGO_ROOT_PASS=replace-with-openssl-rand-hex-32
# Redis password shared by vie-api and the summarizer
REDIS_PASSWORD=replace-with-openssl-rand-hex-32
# RabbitMQ user, created on the first boot of an empty broker volume
RABBITMQ_USER=vie
# RabbitMQ password
RABBITMQ_PASS=replace-with-openssl-rand-hex-32
# Signs 15-minute access tokens (32+ characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Signs 7-day refresh tokens; must differ from JWT_SECRET
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
# Shared by vie-api, summarizer, worker and assistant for internal calls
INTERNAL_SECRET=your-internal-secret-generate-with-openssl-rand
# vie-admin login key and vie-api admin-route key (32+ characters)
ADMIN_API_KEY=dev-admin-key-change-me
# Paddle billing is not wired up; any random value satisfies the production boot check
PADDLE_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32

# ------------------------------------------------
# REQUIRED — AWS (the EC2 instance role supplies credentials; no keys in this file)
# ------------------------------------------------
# Region of S3_BUCKET; presigned frame URLs break if this is wrong
AWS_REGION=eu-north-1
# Bucket for frames, transcripts and nightly backups
S3_BUCKET=vie-transcripts

# ------------------------------------------------
# REQUIRED — LLM provider
# ------------------------------------------------
# Anthropic key for the pipeline and chat (set a monthly spend limit in the console)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ------------------------------------------------
# REQUIRED — demo spend guards
# ------------------------------------------------
# false = signup returns 403 and is hidden in the UI; create users with scripts/create-admin.ts
ALLOW_REGISTRATION=false
# Longest video accepted, in minutes
MAX_VIDEO_DURATION_MINUTES=30
# Longest video allowed onto the paid audio-transcription fallback, in minutes
WHISPER_MAX_DURATION_MINUTES=30
# Videos each user may submit per 24 hours
VIDEO_DAILY_LIMIT=5
# Daily LLM spend cap per free-tier user, in USD
USER_COST_LIMIT_FREE=1
# Pipelines the worker runs at the same time
WORKER_CONCURRENCY=1
# Frame-description model (blank falls back to the pricier primary model)
LLM_VISION_MODEL=anthropic/claude-haiku-4-5-20251001
# Enrichment-stage model (blank falls back to the fast tier)
LLM_ENRICHMENT_MODEL=anthropic/claude-haiku-4-5-20251001
# Lifetime of frame URLs vie-api re-signs, in seconds (short: instance-role credentials rotate)
FRAME_URL_TTL_SECONDS=3600
# Lifetime of frame URLs the summarizer signs, in seconds; keep >= FRAME_URL_TTL_SECONDS
S3_PRESIGNED_URL_EXPIRY=3600

# ------------------------------------------------
# OPTIONAL — extra providers and YouTube access
# ------------------------------------------------
# OpenAI key; enables the Whisper audio fallback for videos without captions
OPENAI_API_KEY=
# Gemini key; its presence alone enables the Gemini audio fallback (use a paid-tier project)
GEMINI_API_KEY=
# Primary LLM provider: anthropic, openai or gemini
LLM_PROVIDER=anthropic
# Fast-tier provider; blank = the primary provider's fast model (openai needs OPENAI_API_KEY)
LLM_FAST_PROVIDER=
# Fallback provider when the primary fails; blank = none (gemini needs GEMINI_API_KEY)
LLM_FALLBACK_PROVIDER=
# Webshare residential proxy user for YouTube caption fetches
WEBSHARE_PROXY_USERNAME=
# Webshare residential proxy password
WEBSHARE_PROXY_PASSWORD=
# yt-dlp player clients for downloads; pick the value that works from the server IP
YTDLP_PLAYER_CLIENTS=android
# 720p second pass for key frames; false cuts one YouTube download per video
SCENE_HIRES_ENABLED=true
# Hugging Face token for embedding-model downloads (avoids anonymous rate limits)
HF_TOKEN=

# ------------------------------------------------
# OPTIONAL — observability and alerts
# ------------------------------------------------
# Backend Sentry DSN (empty = disabled)
SENTRY_DSN=
# Deploy identifier shown in Sentry, e.g. the git short SHA
SENTRY_RELEASE=
# Browser Sentry DSN from a separate project, baked in at web build time
VITE_SENTRY_DSN=
# Browser release identifier, baked in at web build time; match SENTRY_RELEASE
VITE_SENTRY_RELEASE=
# Langfuse public key (tracing is off unless both keys are set)
LANGFUSE_PUBLIC_KEY=
# Langfuse secret key
LANGFUSE_SECRET_KEY=
# Langfuse host (cloud.langfuse.com is the EU region)
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Salt for hashed user ids in Langfuse traces (openssl rand -hex 16)
LANGFUSE_USER_ID_HASH_SALT=
# Slack, Discord or ntfy webhook that receives cost, stall and backup alerts
ALERT_WEBHOOK_URL=
# Per-call LLM cost that triggers a high_cost_call alert, in USD
ALERT_COST_THRESHOLD_USD=0.50

# ------------------------------------------------
# OPTIONAL — tuning
# ------------------------------------------------
# Daily LLM spend cap per pro-tier user, in USD
USER_COST_LIMIT_PRO=20
# Daily LLM spend cap per team-tier user, in USD (-1 = unlimited)
USER_COST_LIMIT_TEAM=-1
# Worker retries before a job is dead-lettered
WORKER_MAX_RETRIES=3
# Local backup directories kept by scripts/backup.sh
BACKUP_KEEP=14
# Age of the newest backup that triggers the backup_stale alert, in hours
BACKUP_MAX_AGE_HOURS=26
# Log verbosity for the Python services: debug, info, warning, error
LOG_LEVEL=info

# ------------------------------------------------
# OPTIONAL — local development only (not needed on the server)
# ------------------------------------------------
# Mongo URI for running vie-api outside Docker
MONGODB_URI=mongodb://localhost:27017/video-insight-engine
# Extra CORS origins, comma-separated (e.g. the Playwright dev server)
CORS_ADDITIONAL_ORIGINS=
# Static AWS keys, only on machines without an instance role
# AWS_ACCESS_KEY_ID=
# Static AWS secret key, only on machines without an instance role
# AWS_SECRET_ACCESS_KEY=
# Account for scripts/run_eval.py (the script reads exported env vars, not this file)
# EVAL_USER_EMAIL=eval@vie.local
# Password for the eval account (8+ chars with upper, lower and a digit)
# EVAL_USER_PASSWORD=
