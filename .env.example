# ================================================
# Video Insight Engine - Environment Configuration
# ================================================
# Copy this file to .env and fill in your values
# ================================================
CLAUDE_PROJECT_DIR="/path/to/your/video-insight-engine"

# ------------------------------------------------
# General
# ------------------------------------------------
NODE_ENV=development
# Log level: debug, info, warning, error (debug is very verbose)
LOG_LEVEL=info

# ------------------------------------------------
# MongoDB
# ------------------------------------------------
# Development (no auth)
MONGODB_URI=mongodb://localhost:27017/video-insight-engine

# Production (with auth)
# MONGO_ROOT_USER=admin
# MONGO_ROOT_PASS=change-this-password

# ------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------
# IMPORTANT: Generate secure secrets for production!
# Use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------
# API Service (vie-api)
# ------------------------------------------------
PORT=3000

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Video creation daily limit (0 = unlimited, useful for dev/admin)
VIDEO_DAILY_LIMIT=5

# Self-service signup (docker-compose.prod.yml only). false = POST /api/auth/register
# returns 403 and the web app hides signup; create users with scripts/create-admin.ts
ALLOW_REGISTRATION=false

# Demo mode. With both set, the login page shows "Try the demo" and the landing
# page signs visitors in as this account; the browser never receives the
# password. Leave both blank to disable. Create the account with
# scripts/create-demo-user.mjs (docs/DEPLOY.md, "Demo mode").
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Per-user daily LLM cost cap, in USD (0 disables the limit, -1 = unlimited)
# Enforced in POST /api/videos via CostMonitorService.reserveUserCost
USER_COST_LIMIT_FREE=1
USER_COST_LIMIT_PRO=20
USER_COST_LIMIT_TEAM=-1

# Global aggregate cost ceiling (USD/day) — separate from the per-user cap above
COST_DAILY_LIMIT=50

# ------------------------------------------------
# Frontend & CORS
# ------------------------------------------------
FRONTEND_URL=http://localhost:5173

# Additional CORS origins (comma-separated, optional)
# Used for SSE endpoints that bypass Fastify's CORS plugin
# CORS_ADDITIONAL_ORIGINS=https://staging.yourdomain.com,https://preview.yourdomain.com

# Vite environment variables
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws

# Debug WebSocket events (development only)
# VITE_DEBUG_WS=true

# Production (update with your domain)
# VITE_API_URL=https://api.yourdomain.com/api
# VITE_WS_URL=wss://api.yourdomain.com/ws

# ------------------------------------------------
# Internal Service Communication
# ------------------------------------------------
# IMPORTANT: Generate a secure secret for production!
# Use: openssl rand -base64 32
INTERNAL_SECRET=your-internal-secret-generate-with-openssl-rand

# ------------------------------------------------
# Internal Service URLs
# ------------------------------------------------
SUMMARIZER_URL=http://localhost:8000

# ------------------------------------------------
# RabbitMQ — pipeline job queue (vie-rabbitmq)
# ------------------------------------------------
# Management UI: http://localhost:15672 (creds = RABBITMQ_DEFAULT_USER / PASS)
RABBITMQ_DEFAULT_USER=vie
RABBITMQ_DEFAULT_PASS=vie-dev
RABBITMQ_URL=amqp://vie:vie-dev@vie-rabbitmq:5672/

# Toggle queue-based pipeline. When false, the API calls the summarizer over HTTP
# (legacy path); when true, video creation publishes a job to RabbitMQ and the
# vie-summarizer-worker consumes it. Flip on a per-environment basis during rollout.
USE_QUEUE_PIPELINE=false

# Worker tuning — concurrent jobs per worker process and total retries before DLQ.
WORKER_CONCURRENCY=1
WORKER_MAX_RETRIES=3
# Base retry delay in seconds, doubled per attempt (5 → 10 → 20), capped at 120.
# WORKER_RETRY_BACKOFF_SECONDS=5

# Admin key used by GET /api/admin/queue/* endpoints (separate from JWT auth).
ADMIN_API_KEY=dev-admin-key-change-me

# ------------------------------------------------
# Summarizer Service (vie-summarizer)
# ------------------------------------------------
SUMMARIZER_PORT=8000

# ------------------------------------------------
# Assistant Service (vie-assistant)
# ------------------------------------------------
ASSISTANT_PORT=8001
# ASSISTANT_URL=http://localhost:8001
# MAX_CONTEXT_CHUNKS=8
# MAX_CONVERSATION_TURNS=20
# Retrieval relevance floor (cosine similarity; 0 disables). Hits below it are
# dropped before context assembly instead of padding the prompt with noise.
# RAG_MIN_SCORE=0.25
# Sentence-transformer encoder — MUST match the summarizer's value or retrieval
# silently degrades (a parity test pins the defaults; override both together).
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ------------------------------------------------
# LLM Provider Configuration (Multi-Provider)
# ------------------------------------------------
# Provider options: anthropic, openai, gemini
LLM_PROVIDER=anthropic
LLM_FAST_PROVIDER=openai
LLM_FALLBACK_PROVIDER=gemini

# Token limits
LLM_MAX_TOKENS=4096
LLM_FAST_MAX_TOKENS=2048

# Timeouts and retries
LLM_TIMEOUT_SECONDS=60.0
LLM_NUM_RETRIES=2

# Optional model overrides (uses provider defaults if not set)
# LLM_MODEL=anthropic/claude-sonnet-4-6
# LLM_FAST_MODEL=openai/gpt-4o-mini

# Assistant chat + agentic-loop model (vie-assistant only — does NOT affect the
# summarizer). Blank → the PRIMARY provider's fast tier (anthropic → Haiku), so
# chat is cheap/fast by default. Set to put chat back on Sonnet:
# LLM_CHAT_MODEL=anthropic/claude-sonnet-4-6

# Per-stage model overrides — pick a model per pipeline stage.
# Defaults below reflect the 2026-05-19 benchmark winners
# (reports/fast-model-bench-20260519-074647.md).  Leaving any of these blank
# falls back to LLM_FAST_MODEL.  Set explicitly to lock a specific model.
#
# Only two stages are pinned: enrichment (+35% quality) and vision (-67% cost).
# Classifier/translation/synthesis stay on the default fast tier — the bench
# alternatives only saved fractions of a cent and would add a third provider.
LLM_ENRICHMENT_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_VISION_MODEL=anthropic/claude-haiku-4-5-20251001
# LLM_CLASSIFIER_MODEL=openai/gpt-4o-mini       # blank → LLM_FAST_MODEL
# LLM_CHAPTER_DETECT_MODEL=openai/gpt-4o-mini
# LLM_DESCRIPTION_MODEL=openai/gpt-4o-mini
# LLM_SYNTHESIS_MODEL=openai/gpt-4o-mini
# LLM_TRANSLATION_MODEL=openai/gpt-4o-mini
# Extraction override pins ALL extraction passes (incl. retries) to the chosen
# model — distinct from EXTRACTION_USE_FAST_FIRST, which only routes the first
# pass to fast and escalates retries to primary. Blank → primary model (Sonnet).
# LLM_EXTRACTION_MODEL=anthropic/claude-haiku-4-5-20251001

# ------------------------------------------------
# Provider API Keys
# ------------------------------------------------
# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------
# Langfuse — LLM observability (optional)
# ------------------------------------------------
# Sign up at https://cloud.langfuse.com (free tier: 50K observations/month).
# Leave blank to disable observability — all instrumentation is no-op without keys.
# Create separate projects for dev and prod and swap keys per environment.
#
# Data flow warning: enabling Langfuse ships LLM prompts and outputs to a
# third-party SaaS. Transcripts and OCR text are redacted only for the
# known token formats (JWT, AWS, Anthropic, OpenAI, GitHub) plus email
# and phone-shaped runs. See docs/OBSERVABILITY.md for the full redaction
# model and how to harden it for your compliance posture.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Sample fraction of extracted items the faithfulness judge will check (0.0–1.0).
# Lower = cheaper; 0 disables the judge entirely.
LANGFUSE_FAITHFULNESS_SAMPLE_RATE=0.2
# User-id propagation: "identity" (default) | "hash" | "omit".
# Use "hash" or "omit" when you don't want internal user ids visible in
# Langfuse traces; "hash" still lets you correlate spans for the same user.
LANGFUSE_USER_ID_MODE=identity
# Salt used by the "hash" mode. Rotate to invalidate prior correlations.
LANGFUSE_USER_ID_HASH_SALT=
# Prompt templates: "registry" (default — the Langfuse `production` label wins
# over the local .txt) | "disk" (always the local .txt; dev-only, for editing
# prompts without re-registering — ignored when ENVIRONMENT=production/staging).
PROMPT_SOURCE=registry
# Admin "Open in Langfuse" deep-links: the vie-admin BACKEND resolves each run's
# trace from the LANGFUSE_* keys above (project id auto-resolved from the keys, or
# pin it with LANGFUSE_PROJECT_ID) and returns a direct trace URL — no extra config
# needed. Optionally set LANGFUSE_PROJECT_ID to skip the one-time project lookup.
LANGFUSE_PROJECT_ID=
# Optional client-side fallback only (build-time, browser-exposed, non-secret).
# Superseded by the backend resolver above; leave blank unless you want a
# tag-filter link when the backend keys are absent.
VITE_LANGFUSE_BASE_URL=https://cloud.langfuse.com
VITE_LANGFUSE_PROJECT_ID=

# ------------------------------------------------
# Sentry (optional — empty DSN = SDK no-ops)
# ------------------------------------------------
# SENTRY_DSN=
# Falls back to ENVIRONMENT when unset.
# SENTRY_ENVIRONMENT=
# Usually the deploy git SHA. Empty in dev is expected (shows as release= in
# the sentry_initialized startup log line). e.g. SENTRY_RELEASE=$(git rev-parse --short HEAD)
# SENTRY_RELEASE=
# Frontend (apps/web) — baked into the bundle at BUILD time via compose build
# args, so `docker compose build vie-web` after changing. Empty = SDK no-ops.
# Use a separate Sentry project/DSN for the browser; never reuse a backend DSN.
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=

# ------------------------------------------------
# Hugging Face Hub (optional)
# ------------------------------------------------
# Token for authenticated model downloads (SentenceTransformer embedding model).
# Blank works but is rate-limited and logs "unauthenticated requests" warnings.
# HF_TOKEN=

# ------------------------------------------------
# YouTube proxy
# ------------------------------------------------
# One proxy for EVERY YouTube request (yt-dlp downloads, metadata, playlists, captions).
# Full URL with credentials, e.g. http://user:pass@host:port; blank = direct.
# Needed where the server IP is bot-checked (cloud hosts). Must be a residential/ISP exit.
# With a proxy set, frames come from one proxied 720p download (no stream-URL seeks).
YOUTUBE_PROXY_URL=
# Sticky exits behind the gateway (Webshare USERNAME-1 … USERNAME-N). A caption 429
# retries on the next exit; 1 = retry on the same exit.
# YOUTUBE_PROXY_EXIT_COUNT=1

# ------------------------------------------------
# Whisper transcription tuning (optional — sensible defaults in config.py)
# ------------------------------------------------
# All optional; uncomment only to override. Whisper is the audio fallback when
# YouTube captions are unavailable/rate-limited. OPENAI_API_KEY is what actually
# enables it.
#
# Per-request OpenAI timeout for ONE chunk (upload + transcription). Bounds a
# stalled call (incl. the first chunk) so it fails in minutes instead of hanging.
# WHISPER_CLIENT_TIMEOUT_SECONDS=300.0
# Retries per chunk. SDK default is 2; 1 keeps worst-case latency under control.
# WHISPER_MAX_RETRIES=1
# How many chunks of a long video transcribe at once. Higher = faster but more
# OpenAI rate-limit pressure. 2-chunk videos finish in ~one chunk's wall-clock.
# WHISPER_CHUNK_CONCURRENCY=3
# Keepalive cadence (seconds) emitted while a phase runs silently (e.g. multi-
# minute Whisper). Must stay well under the API gateway proxy's 300s body
# timeout, or an idle-but-live SSE stream gets dropped.
# SSE_HEARTBEAT_SECONDS=12.0

# Hard caps (docker-compose.prod.yml passes these; demo values shown).
# Longest accepted video, and longest video allowed onto the paid audio fallback.
MAX_VIDEO_DURATION_MINUTES=30
WHISPER_MAX_DURATION_MINUTES=30

# ------------------------------------------------
# S3 — uses existing vie-transcripts bucket for all media (frames, transcripts, audio)
# ------------------------------------------------
S3_BUCKET=vie-transcripts
# Keep >= the api gateway's FRAME_URL_TTL_SECONDS (21600) so SSE-delivered
# frame URLs don't 403 before the api re-signs them.
S3_PRESIGNED_URL_EXPIRY=21600
# Lifetime of a presigned frame URL, in seconds
FRAME_URL_TTL_SECONDS=21600

# AWS S3
# Free tier: 5GB storage, 20K GET, 2K PUT requests/month
# Create bucket at: https://s3.console.aws.amazon.com/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Frame extraction (extract actual video frames for visual blocks)
FRAME_EXTRACTION_ENABLED=true

# Hi-res frame refinement — re-extract the ~25 selected scene frames at 720p
# via a stream-URL seek before S3 upload. Disable to keep single-pass low-res.
SCENE_HIRES_ENABLED=true
# Versioned S3 prefix for scene frames; bump to invalidate the
# frames-already-exist S3 cache after quality changes
# ("scenes" = pre-hires low-res, "scenes-v2" = pre-adaptive-vision).
SCENE_S3_PREFIX=scenes-v3
# yt-dlp player clients for video/audio downloads. YouTube per-environment
# blocks some clients' download URLs (2026-08: web 403s here, android works
# but caps at 360p without a PO-token provider; 2026-09: SABR experiment can
# strip android audio-only formats — audio downloads fall back to demuxing
# the progressive stream). NEVER include "default"/web (403s) or android_vr
# (PO-token-gated, downloads 403). Adjust when YouTube shifts.
# YTDLP_PLAYER_CLIENTS=android
# Clients for the hi-res 720p download only (hires prefetch, refiner fallback,
# moment fill). 2026-10-06: web_embedded/tv_embedded get 720p, android caps at
# 360p. A failed download retries once with YTDLP_PLAYER_CLIENTS.
# YTDLP_HIRES_PLAYER_CLIENTS=web_embedded,android

# Optional: Use LocalStack for offline S3 development.
# AWS_ENDPOINT_URL MUST be browser-reachable — the API regenerates presigned
# URLs against this endpoint and the frontend then loads images directly from
# it. Use http://localhost:4566 (NOT http://localstack:4566 or any
# docker-internal hostname), otherwise <img> tags will fail to resolve.
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# ------------------------------------------------
# Future Services (not used in MVP)
# ------------------------------------------------

# Meilisearch (for full-text search)
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=your-meilisearch-key

# Qdrant (for vector search)
# QDRANT_HOST=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-key

# Redis — backs the API's dispatch guard (prevents duplicate queue publishes
# for the same video_summary_id) AND the summarizer's per-video pipeline lock.
# MUST be the same instance across both services for operational coherence.
REDIS_URL=redis://vie-redis:6379
# TTL on the per-(video_summary_id) dispatch guard. Must exceed the
# summarizer's PIPELINE_LOCK_TTL_SECONDS (default 600). 900s = 50% headroom.
DISPATCH_GUARD_TTL_SECONDS=900

# Trust proxy — flip ON in deployments behind a CDN / load balancer / ingress
# so `req.ip` is derived from X-Forwarded-For instead of the direct TCP
# connection. Otherwise share-view dedup and IP-keyed rate limits collapse to
# the proxy's single IP. Accepts: "true"/"false", an integer hop count
# (e.g. "1" to trust last hop), or a comma-separated CIDR allowlist.
# TRUST_PROXY=false

# ────────────────────────────────────────────────────
# Production-only (docker-compose.prod.yml — every one
# of these is MANDATORY there via ${VAR:?}; compose
# refuses to boot without them)
# ────────────────────────────────────────────────────
# MONGO_ROOT_USER=vieadmin
# MONGO_ROOT_PASS=generate-with-openssl-rand-base64-32
# REDIS_PASSWORD=generate-with-openssl-rand-base64-32
# RABBITMQ_USER=vie
# RABBITMQ_PASS=generate-with-openssl-rand-base64-32
# PADDLE_WEBHOOK_SECRET=from-paddle-dashboard
# FRONTEND_URL=https://vie.example.com
# VITE_API_URL=https://api.vie.example.com/api
# VITE_WS_URL=wss://api.vie.example.com/ws

# LLM alert delivery — every llm_alerts row (high-cost call, daily spend
# spike, failure rate) is also POSTed as JSON here. Empty = Mongo-only.
# Must be http(s):// — other schemes are rejected.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Per-call high-cost alert threshold in USD (llm_common/callback.py). Default 0.50.
# ALERT_COST_THRESHOLD_USD=0.50

# Backups — scripts/backup.sh and the opt-in vie-backup-cron sidecar
# (`docker compose --profile backup up -d`). BACKUP_KEEP = timestamp dirs
# retained under ./backups; BACKUP_MAX_AGE_HOURS = vie-admin's backup_stale
# dead-man's switch (newest manifest older than this trips an alert).
# BACKUP_KEEP=14
# BACKUP_MAX_AGE_HOURS=26

# Stall sweeper (summarizer HTTP process, src/services/stall_sweeper.py) —
# flips `processing` rows with no progress for STALL_THRESHOLD_MINUTES and no
# live producer lock to `failed`, then writes + delivers a pipeline_stalled alert.
# STALL_SWEEP_ENABLED=true
# STALL_SWEEP_INTERVAL_SECONDS=300
# STALL_THRESHOLD_MINUTES=30

# ------------------------------------------------
# Eval runner (scripts/run_eval.py) — local-only account, auto-registered
# on first run. Intentionally NO default password: pick your own
# (8+ chars, upper/lower/digit). Email/name are optional overrides.
# ------------------------------------------------
# EVAL_USER_PASSWORD=
# EVAL_USER_EMAIL=eval@vie.local

# ------------------------------------------------
# Keys read by the code that this file did not list
# ------------------------------------------------
# Fraction of transactions Sentry traces, 0 disables tracing
# SENTRY_TRACES_SAMPLE_RATE=0.1
