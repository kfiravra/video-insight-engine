    {
      "type": "stat",
      "title": "Runs (1h)",
      "description": "Finished pipeline runs in the last hour, cache hits excluded (completed, failed, interrupted).",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({environment=\"$env\", service=~\"vie-summarizer|vie-summarizer-worker\"} |= \"pipeline_run_finished\" | json | __error__=\"\" | event=\"pipeline_run_finished\" | status!=\"cache_hit\" [1h]))",
          "legendFormat": "",
          "editorMode": "code",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
