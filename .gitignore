# ================================================
# Video Insight Engine
# ================================================
dev/research/*
dev/completed/*
# golden-dataset: eval CI reads baseline.json + videos.yaml — keep those in git
dev/golden-dataset/*
!dev/golden-dataset/baseline.json
!dev/golden-dataset/videos.yaml
# per-metric eval noise (0.7) — gate.py tolerances, committed after each baseline
!dev/golden-dataset/noise.json
.claude/skills/impeccable2

# Skill / audit workspaces (generated artifacts, not source-of-truth)
.impeccable/
audit/
reports/
# Environment
.env
.env.*
!.env.example
!.env.production.example

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.Python

# Build
dist/
build/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log
npm-debug.log*

# Testing
coverage/
.coverage
vitest-report.json
htmlcov/
.pytest_cache/
playwright-report/
test-results/
perf-*.png
.playwright-mcp/

# Local screenshots / scratch images at repo root
/landing-light.png
/login.png

# Local Docker BuildKit config
/buildkitd.toml

# Docker
docker-compose.override.yml

# Misc
*.tmp
*.temp
.cache/
.mcp.json

# Claude Code
.claude/tdd-state.json
.claude/tsc-cache/
# git-safety-guard single-use override — a committed one disarms the guard in every clone
.claude/hooks/.git-safety-override

# Data backups (scripts/backup.sh output)
backups/

# Local diagnostics dumps (contain presigned URLs) — untracked, keep on disk only
respone.json
dev/diagnostics/

# Demo preload exports (scripts/demo-export.sh) — local copies of cached videos
demo-data/

# pipeline-1min raw research answers (378 KB, session-scoped evidence; digest + code maps stay tracked)
dev/active/pipeline-1min/evidence/ans-*.md

# Hook-written session snapshots (.claude/hooks/auto-save-context.sh) — local state, never committed
dev/active/.last-session-snapshot.json
dev/active/*/*-session-snapshot.json
